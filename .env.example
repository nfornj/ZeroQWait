# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=zeroqwait
DB_USER=postgres
DB_PASSWORD=zeroqwait_dev

# Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Model Configuration
OLLAMA_URL=http://localhost:11434/v1
MODEL_NAME=qwen3:14b-q4_K_M

# LLM Provider (nvidia | ollama | groq | openai | anthropic | google_genai)
# nvidia is the platform default. Requires NVIDIA_API_KEY.
LLM_PROVIDER=nvidia
NVIDIA_MODEL=z-ai/glm4.7
# NVIDIA_API_KEY=nvapi-...  # Never commit the real key
# GROQ_API_KEY=gsk_...     # Backup provider (set ENABLE_GROQ_PROVIDER=true to activate)

# Voice Configuration
TTS_SERVICE_URL=http://localhost:8880

# JWT Secret Key for authentication
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# SuperTokens authentication (EmailPassword + Session recipes)
SUPERTOKENS_CONNECTION_URI=http://supertokens-svc:3567
SUPERTOKENS_API_KEY=your_supertokens_api_key

# Frontend configuration
REACT_APP_API_URL=http://localhost:8000/api

# Production Frontend URL (for CORS and email links)
FRONTEND_URL=https://zeroqwait.com

# Infisical bootstrap configuration (create Machine Identities in Infisical Access Control > Machine Identities)
INFISICAL_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=your_infisical_project_id
INFISICAL_ENV=test
INFISICAL_CLIENT_ID=your_infisical_machine_identity_client_id
INFISICAL_CLIENT_SECRET=your_infisical_machine_identity_client_secret
INFISICAL_SECRET_PATH=/

# Email Configuration (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_password

# Stripe Configuration (optional)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Backblaze B2 S3-compatible storage (create an application key in Backblaze > App Keys; endpoint is shown with the bucket region)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=your_backblaze_b2_key_id
B2_APP_KEY=your_backblaze_b2_application_key
B2_BUCKET_NAME=your_backblaze_b2_bucket_name

# MCP Services
BOOKING_MCP_URL=http://localhost:8890
FINANCE_MCP_URL=http://localhost:8891
HR_MCP_URL=http://localhost:8892
ODOO_MCP_URL=http://localhost:8893
POSTGRES_MCP_URL=http://localhost:8894

# Finance dynamic reads (local guarded SQL trial)
FINANCE_DYNAMIC_READS_MODE=local

# Odoo ERP
ODOO_URL=http://odoo:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin
